[sub_resource type="Shader" id="Shader_body"]
code = "shader_type spatial;\nrender_mode cull_back;\nuniform vec4 base_color : source_color = vec4(0.05, 0.42, 0.95, 1.0);\nuniform vec4 accent_color : source_color = vec4(0.15, 1.0, 0.72, 1.0);\nvoid fragment() {\n    float band = 0.5 + 0.5 * sin(UV.y * 24.0 + UV.x * 9.0 + TIME * 0.45);\n    float edge = pow(1.0 - max(dot(NORMAL, VIEW), 0.0), 2.0);\n    ALBEDO = mix(base_color.rgb, accent_color.rgb, band * 0.24 + edge * 0.55);\n    METALLIC = 0.28;\n    ROUGHNESS = 0.24;\n    EMISSION = accent_color.rgb * edge * 0.10;\n}"

